generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("user")
  gesperrt      Boolean   @default(false)
  inserate      Inserat[]
  createdAt     DateTime  @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

model Inserat {
  id           String   @id @default(cuid())
  titel        String
  beschreibung String
  preis        Int
  zimmer       Float
  flaeche      Int
  strasse      String
  plz          String
  ort          String
  typ          String   @default("wohnung")
  modus        String   @default("mieten")
  kanton       String?
  bilder       String[]
  dokumente    String[]
  lat          Float?
  lng          Float?
  aktiv        Boolean  @default(true)
  aktivVorSperre Boolean?
  geprueft     Boolean  @default(false)
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  views        InseratView[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model InseratView {
  id        String   @id @default(cuid())
  inseratId String
  inserat   Inserat  @relation(fields: [inseratId], references: [id], onDelete: Cascade)
  ip        String?
  ipDomain  String?
  host      String?
  createdAt DateTime @default(now())

  @@index([inseratId])
  @@index([inseratId, createdAt])
}

model Settings {
  id                  String   @id @default("default")
  registrationEnabled Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}
